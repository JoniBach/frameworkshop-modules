{
  "name": "frameworkshop",
  "version": "1.0.0",
  "description": "Multi-framework learning workspace",
  "scripts": {
    "submodules:init": "git submodule update --init --recursive",
    "submodules:sync": "git submodule sync --recursive",
    "submodules:main": "git submodule foreach --recursive 'git checkout main && git pull origin main'",
    "submodules:update": "git submodule update --remote --recursive",
    "submodules:status": "git submodule status --recursive",
    "setup:all": "npm-run-all --parallel install:*",
    "install:angular": "cd frameworkshop-angular && npm install",
    "install:react": "cd frameworkshop-react && npm install",
    "install:vue": "cd frameworkshop-vue && npm install",
    "install:svelte": "cd frameworkshop-svelte && npm install",
    "install:solid": "cd frameworkshop-solid && npm install",
    "start:all": "npm-run-all --parallel workshop:*",
    "workshop:angular": "cd frameworkshop-angular && npm run workshop",
    "workshop:react": "cd frameworkshop-react && npm run workshop",
    "workshop:vue": "cd frameworkshop-vue && npm run workshop",
    "workshop:svelte": "cd frameworkshop-svelte && npm run workshop",
    "workshop:solid": "cd frameworkshop-solid && npm run workshop",
    "workshop:deno": "cd frameworkshop-deno && deno run --allow-net --allow-read --allow-write --unstable-kv main.ts"
  },
  "devDependencies": {
    "npm-run-all2": "^8.0.4"
  }
}